// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactSubmission {
  id                 String   @id @default(cuid())
  accountId          String
  firstName          String
  lastName           String
  email              String
  budget             Int
  projectDescription String   @db.Text
  status             String   @default("NEW") // NEW | REPLIED | CLOSED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([accountId])
  @@index([createdAt])
  @@index([email])
  @@index([status])
  @@map("contact_submissions")
}

model BlogCategory {
  id          String     @id @default(cuid())
  accountId   String
  name        String
  slug        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       BlogPost[]

  @@unique([accountId, slug])
  @@index([accountId])
  @@map("blog_categories")
}

model BlogPost {
  id              String        @id @default(cuid())
  accountId       String
  categoryId      String?
  category        BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title           String
  slug            String
  summary         String?       @db.Text
  content         String        @db.Text
  metaTitle       String?
  metaDescription String?       @db.Text
  coverImage      String?
  contentImages   String[]      @default([])
  author          String?       @default("KABO Editorial")
  tags            String[]      @default([])
  isPublished     Boolean       @default(true)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([accountId, slug])
  @@index([accountId])
  @@index([accountId, isPublished])
  @@index([accountId, slug])
  @@map("blog_posts")
}

model Template {
  id          String   @id @default(cuid())
  accountId   String   @default("default-account")
  slug        String
  title       String
  description String   @db.Text
  image       String
  demoImages  String[] @default([])
  category    String
  tags        String[] @default([])
  features    String[] @default([])
  price       Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  liveUrl     String?
  pbConfig    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([accountId, slug])
  @@index([accountId])
  @@index([accountId, category])
  @@index([accountId, isActive])
  @@index([accountId, slug])
  @@map("templates")
}

model CustomPage {
  id         String   @id @default(cuid())
  accountId  String   @default("default-account")
  slug       String
  title      String
  templateId String
  pbConfig   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([accountId, slug])
  @@index([accountId])
  @@index([accountId, slug])
  @@map("custom_pages")
}

